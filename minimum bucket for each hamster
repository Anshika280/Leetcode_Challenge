class Solution {
    public int minimumBuckets(String hamsters) {
        char[] arr = hamsters.toCharArray();
        int n = arr.length;
        int buckets = 0;

        for (int i = 0; i < n; i++) {
            if (arr[i] != 'H') {
                continue;
            }

            // Already fed by a bucket on the left
            if (i > 0 && arr[i - 1] == 'B') {
                continue;
            }

            // Place bucket on the right
            if (i + 1 < n && arr[i + 1] == '.') {
                arr[i + 1] = 'B';
                buckets++;
            }
            // Otherwise, place bucket on the left
            else if (i > 0 && arr[i - 1] == '.') {
                arr[i - 1] = 'B';
                buckets++;
            }
            // No possible position
            else {
                return -1;
            }
        }

        return buckets;
    }
}
